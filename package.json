{
  "name": "dittogen",
  "private": true,
  "type": "module",
  "pnpm": {
    "supportedArchitectures": {
      "os": ["linux", "darwin", "win32"],
      "cpu": ["x64", "arm64"]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "pnpm": "^9.15.9",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
